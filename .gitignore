.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
site/

# LTspice and generated simulation artifacts
runs/*
!runs/.gitkeep
*.raw
*.op.raw
!tests/fixtures/*.raw
*.log
!tests/fixtures/*.log
*.db
*.exe.log
*.net
examples/**/generated/

# Keep generated documentation assets opt-in.
docs-site/site/
docs-site/pages/assets/generated/*
!docs-site/pages/assets/generated/.gitkeep
!docs-site/pages/assets/generated/opamp-summing.svg
!docs-site/pages/assets/generated/sallen-key-lowpass.svg
examples/transient/*/*.svg

# MCP/runtime sidecars
.ltspice-mcp/

# Experiment datasets (re-downloaded by the trainer)
experiments/*/data/

# Vendor SPICE models extracted for documentation (never commit)
experiments/**/models/*.lib

# LM741 lib copies staged next to RS2 netlists (canonical: models/)
experiments/*/lm741_*.lib

# Vendor datasheets (fetched, never committed)
experiments/**/datasheet/
reports/**/imagens/datasheet-*.pdf
